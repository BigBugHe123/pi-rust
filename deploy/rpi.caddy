# rpi.laofu.online - rpi Rust Agent Toolkit static website
# rpi.bigfisharc.cn is generated from this block by the server's gen_bigfisharc.py.
rpi.laofu.online {
    encode gzip
    root * /var/www/rpi

    # Keep header ordering explicit: errors/redirects must not inherit a cache TTL.
    route {
        header Cache-Control "no-store"

        @private path_regexp private (?i)(^|/)\.(rpi|deploy|git)(/|$)
        respond @private 404

        # Direct Markdown visits open the rendered guide (guide.js fetches content/*.html).
        redir /user-guide.md /guide.html?doc=user-guide 302
        redir /extension-authoring.md /guide.html?doc=extension-authoring 302
        redir /agent-project.md /guide.html?doc=agent-project 302

        @content path / *.html *.json *.md *.xml *.txt
        header @content Cache-Control "public, max-age=0, s-maxage=60, must-revalidate"

        # Versions are maintained by hand, so do not use immutable or year-long TTLs.
        @assets path *.js *.css
        header @assets Cache-Control "public, max-age=300, s-maxage=300"

        @images path *.svg *.png *.jpg *.jpeg *.webp *.ico
        header @images Cache-Control "public, max-age=3600, s-maxage=86400"

        file_server {
            hide .rpi .deploy .git
        }
    }

    handle_errors {
        header Cache-Control "no-store"
        respond "{err.status_code} {err.status_text}" {err.status_code}
    }

    tls {
        issuer acme
    }
}

http://rpi.laofu.online {
    header Cache-Control "no-store"
    redir https://{host}{uri} permanent
}
