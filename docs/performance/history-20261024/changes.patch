-) -> Result<(), RecordLogCorruption> {
-    if let Some(entry) = entries_by_id.get(result_entry_id) {
-        if !matches(entry) {
-            return corrupt(
-                RecordLogCorruptionReason::ProvisionedEntryMismatch,
-                format!(
-                    "Provisioned {} entry {result_entry_id} exists with different content",
