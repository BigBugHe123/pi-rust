-pub async fn complete_simple_with_retries(
-    provider: Arc<dyn Provider>,
-    model: Model,
-    context: Context,
-    mut options: SimpleStreamOptions,
-    retry: Option<RetryPolicy>,
-) -> AssistantMessage {
