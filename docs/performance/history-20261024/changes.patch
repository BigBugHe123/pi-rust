+        let name = session_file_name(1_700_000_000_000, "abc");
+        assert!(name.ends_with("_abc.jsonl"));
+        let ts = name.split('_').next().unwrap();
+        assert!(!ts.contains(':'), "timestamp must not contain ':'");
+        assert!(!ts.contains('.'), "timestamp must not contain '.'");
+        assert!(ts.starts_with("2023-11-14T"));
+    }
