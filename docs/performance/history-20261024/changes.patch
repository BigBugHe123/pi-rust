-
-    // Drive the run on a task so we can cancel mid-stream.
-    let run_handle = tokio::spawn(async move {
-        rpi_agent::run_agent_loop(
-            vec![common::user_message("hello")],
-            AgentContext::default(),
-            config,
-            emit,
-            stream_fn,
-        )
-        .await
-    });
-
