-        let records = session
-            .find_records(&RecordQuery {
-                record_type: Some(rpi_harness::frame_progress::ASSISTANT_FRAME_RECORD_TYPE),
-                ..Default::default()
-            })
-            .await
-            .expect("frame records readable");
-        if !records.is_empty() {
-            return;
-        }
