-        let op_kind = intent_obj
-            .get("kind")
-            .and_then(|v| v.as_str())
-            .ok_or_else(|| schema("has invalid operation kind"))?;
-        if !OPERATION_KINDS.contains(&op_kind) {
-            return Err(schema(format!("has unknown operation kind {op_kind}")));
