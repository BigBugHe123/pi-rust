+    run_id: &str,
+    step: StepKind,
+    attempt_no: u32,
+    result_id: &str,
+    compaction_reason: Option<CompactionReason>,
+) -> LaneRecord {
+    LaneRecord::StepAttempt(StepAttemptRecord {
