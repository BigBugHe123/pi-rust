-pub(crate) fn entry_provisioned_json(entry: &Entry) -> serde_json::Value {
-    let mut value = entry.to_flat_json();
-    if let serde_json::Value::Object(map) = &mut value {
-        map.remove("seq");
-        map.remove("parentId");
-        map.remove("timestamp");
-    }
-    value
-}
