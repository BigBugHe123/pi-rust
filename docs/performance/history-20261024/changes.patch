+            "--home-user-proj--"
+        );
+        // Leading backslash stripped; backslashes + colons → '-'.
+        assert_eq!(
+            jsonl_session_directory_name("\\Users\\bob"),
+            "--Users-bob--"
+        );
+        // `C:\dev` (in TS/literal form): leading char is `C` (not a slash, no
